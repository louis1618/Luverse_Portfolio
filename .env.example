# This file is a placeholder for environment variables required to run this project.

# Password for protected pages/routes
PAGE_ACCESS_PASSWORD=password

# GitHub API 설정 (관리자 페이지에서 포스트 작성용)
# GitHub Personal Access Token (repo 권한 필요)
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub 사용자명 또는 조직명
GITHUB_OWNER=your_github_username

# 리포지토리 이름
GITHUB_REPO=your_repo_name
